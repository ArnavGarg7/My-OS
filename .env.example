# ─────────────────────────────────────────────────────────────────────────────
# My OS — environment variables
# Copy to `.env` and fill in. Validated by packages/shared/src/env.ts (zod).
# Vendor-standard names are kept as-is; app-specific vars are MYOS_-prefixed
# (see docs/specs/08_Developer_Guidelines.md §2 / §7).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development

# Core (required)
# Local dev via infra/compose.dev.yml uses these credentials.
DATABASE_URL=postgres://myos:myos@localhost:5432/myos
# MYOS_APP_URL = the app's PUBLIC, externally-reachable origin (scheme + host + PORT).
#   - local dev (next dev, direct):        http://localhost:3000
#   - local PRODUCTION (behind Caddy):     http://localhost:8080  ← the mapped MYOS_HTTP_PORT (below);
#                                          web:3000 is internal-only and never exposed to the browser.
#                                          If you change MYOS_HTTP_PORT, change this port to match.
#   - remote (Cloudflare Tunnel):          https://myos.yourdomain.com
MYOS_APP_URL=http://localhost:3000

# Clerk authentication (Sprint 1.5). Create an app at https://dashboard.clerk.com
# and paste the keys below. Leave BOTH blank to run in local single-owner dev mode
# (no sign-in required). In production, set both. Only the IdentityService reads these.
# CLERK_SECRET_KEY is a PRIVATE server secret (runtime only). NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is
# public and, because it is NEXT_PUBLIC_*, is inlined into the browser bundle at DOCKER BUILD time —
# so it must be present when you run `docker compose ... up -d --build` (see the build args in
# infra/docker-compose.yml), not merely at container runtime.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Single-owner production mode (O1 deployment). By default the app REFUSES the local single-owner
# identity when NODE_ENV=production, so an instance can never be accidentally exposed without auth.
# Set this to "true" ONLY when the origin is gated by an external access layer (e.g. Cloudflare Access
# restricting it to your email) — then the app trusts every request as the single owner and no Clerk
# setup is needed. Ignored whenever Clerk is configured (real auth always wins). Leave blank if you use
# Clerk or run only local dev.
MYOS_SINGLE_OWNER=

# ── Google sign-in (Auth.js) — production identity for the self-hosted deploy ──────────────────
# Set MYOS_GOOGLE_AUTH=true to sign in with Google (replaces single-owner; Clerk still wins if set).
# Reuses the MYOS_GOOGLE_CLIENT_ID/SECRET below (one Google app for sign-in AND the Google connector).
# Register the callback in the Google console: https://<your-domain>/api/auth/callback/google
#   (dev: http://localhost:3000/api/auth/callback/google)
# - MYOS_GOOGLE_AUTH / NEXT_PUBLIC_MYOS_GOOGLE_AUTH: set BOTH to "true" (the NEXT_PUBLIC_ one is inlined
#   into the browser bundle at BUILD time, so it must be present for `docker compose ... up -d --build`).
# - AUTH_SECRET: session/JWT encryption key. Generate: openssl rand -base64 33
# - MYOS_OWNER_EMAILS: comma-separated allowlist of Google emails allowed to sign in (just yours).
#   Empty while MYOS_GOOGLE_AUTH=true means nobody can sign in (fail-closed).
MYOS_GOOGLE_AUTH=
NEXT_PUBLIC_MYOS_GOOGLE_AUTH=
AUTH_SECRET=
MYOS_OWNER_EMAILS=

# AI providers (Sprint 5.3 — optional; features degrade to the deterministic Local
# provider when unset; see docs/specs/06_AI_Architecture.md §1 / NFR-9). Server-side ONLY — never
# exposed to the browser, never logged. A provider activates only when its key is set;
# the Local provider is always the offline fallback. Paste your keys in your local .env
# (gitignored), NOT here. Rotate any key that has been shared in plain text.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=
# 32+ char secret used to encrypt provider_credentials at rest. Generate: openssl rand -base64 48
MYOS_AI_CREDENTIALS_SECRET=

# Connector Platform (Sprint 6.4). 32+ char secret used to encrypt connector_credentials at rest
# with AES-256-GCM. DISTINCT from the AI secret — connector credentials are isolated from the AI
# subsystem and never reachable by any AI provider. When unset, connectors run in deterministic
# offline mode (no live OAuth). Generate: openssl rand -base64 48
MYOS_CONNECTOR_SECRET=

# Web Push / VAPID (optional — required for laptop + Android notifications). Generate all three with:
#   npx web-push generate-vapid-keys
#   - MYOS_VAPID_PRIVATE_KEY : PRIVATE server key (runtime only; sends pushes). NEVER expose to client.
#   - MYOS_VAPID_PUBLIC_KEY  : public key (server side).
#   - MYOS_VAPID_SUBJECT     : a mailto: (or https:) contact URL.
#   - NEXT_PUBLIC_MYOS_VAPID_PUBLIC_KEY : set to the SAME value as MYOS_VAPID_PUBLIC_KEY. Because it is
#     NEXT_PUBLIC_*, it is inlined into the browser bundle at DOCKER BUILD time (the browser needs it to
#     create a push subscription) — so it must be present when you `docker compose ... up -d --build`,
#     not just at runtime. Real push also requires HTTPS (your Cloudflare URL); localhost works only for
#     same-machine testing.
MYOS_VAPID_PUBLIC_KEY=
MYOS_VAPID_PRIVATE_KEY=
MYOS_VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_MYOS_VAPID_PUBLIC_KEY=

# Backups (optional — S3-compatible bucket; see docs/specs/05_Database_Design.md §16).
MYOS_BACKUP_S3_ENDPOINT=
MYOS_BACKUP_S3_BUCKET=
MYOS_BACKUP_S3_ACCESS_KEY=
MYOS_BACKUP_S3_SECRET_KEY=
MYOS_BACKUP_AGE_PUBLIC_KEY=

# Deployment (used by infra/docker-compose.yml + Caddy)
MYOS_DOMAIN=localhost

# Caddy site address. Leave blank for local dev or the Cloudflare-Tunnel path (Caddy serves plain HTTP
# on :80 and TLS is terminated elsewhere). For a PUBLIC VM where Caddy owns TLS (e.g. a DuckDNS host),
# set this to your hostname AND set MYOS_HTTP_PORT=80 / MYOS_HTTPS_PORT=443 below — Caddy then obtains a
# Let's Encrypt certificate automatically and serves HTTPS with an 80→443 redirect.
#   MYOS_SITE_ADDRESS=myos.duckdns.org
MYOS_SITE_ADDRESS=

# Host ports My OS's Caddy publishes (O1 port-isolation). Defaults avoid the standard 80/443 so My OS
# can coexist with any other stack already using them on this host. Container-side Caddy still listens
# on 80/443 — only the host publishing changes. If you change MYOS_HTTP_PORT, update MYOS_APP_URL above
# to match (e.g. http://localhost:8080). Remote access via the Cloudflare Tunnel does NOT use these host
# ports (it forwards to caddy:80 over the internal network), so it works regardless.
MYOS_HTTP_PORT=8080
MYOS_HTTPS_PORT=8443

# Postgres container (infra compose only)
POSTGRES_USER=myos
POSTGRES_PASSWORD=myos
POSTGRES_DB=myos

# ── Live connector OAuth credentials (Stage B) ────────────────────────────────
# Server-side ONLY (never NEXT_PUBLIC_). Blank = that provider stays in sample mode.
# Register the callback URL in each provider's OAuth app:
#   dev:  http://localhost:3000/api/connectors/oauth/callback/<provider>
#   prod: https://<your-domain>/api/connectors/oauth/callback/<provider>
#   (<provider> = google-calendar | gmail | google-drive | github | slack)
# Setup steps + scopes: docs/specs/stage-b-live-integrations.md
# One Google OAuth app covers Calendar + Gmail + Drive.
MYOS_GOOGLE_CLIENT_ID=
MYOS_GOOGLE_CLIENT_SECRET=
MYOS_GITHUB_CLIENT_ID=
MYOS_GITHUB_CLIENT_SECRET=
# Slack requires an HTTPS redirect URL (no localhost) — configure over your tunnel/domain.
MYOS_SLACK_CLIENT_ID=
MYOS_SLACK_CLIENT_SECRET=

# ── Always-on worker features (optional) ──────────────────────────────────────
# Set MYOS_INTERNAL_SECRET to enable the worker's background ticks (proactive
# evaluation + live connector auto-sync). When unset, both are disabled and the
# internal endpoints return 503. Crons default to every 15 minutes.
MYOS_INTERNAL_SECRET=
PROACTIVE_EVAL_CRON="*/15 * * * *"
CONNECTOR_SYNC_CRON="*/15 * * * *"

# Data-at-rest encryption key (Stage C, Tier 1). Encrypts private free-text bodies.
# Back this up SEPARATELY from the DB — losing it makes encrypted content unrecoverable.
MYOS_DATA_ENCRYPTION_KEY=
