{
  "name": "@myos/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android shell for My OS. Loads the deployed web app in a native WebView and adds native push, deep-link auth return, and platform niceties. Android-only for now (iOS kept neutral for later).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "cap:open": "cap open android",
    "cap:run": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
