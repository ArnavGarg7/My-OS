# Capacitor / Android build artifacts — the android/ project itself IS committed (generated by
# `cap add android`), but its build output and local/secret files are not.
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/app/debug/
android/capacitor-cordova-android-plugins/
android/local.properties
android/.idea/
android/*.iml

# Firebase / signing secrets — NEVER commit these (see README).
android/app/google-services.json
*.keystore
*.jks
keystore.properties
