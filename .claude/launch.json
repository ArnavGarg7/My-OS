{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@myos/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@myos/web", "exec", "next", "start", "-p", "3000"],
      "port": 3000
    }
  ]
}
