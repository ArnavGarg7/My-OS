# syntax=docker/dockerfile:1
# Worker build: bundle with tsup, ship prod deps via `pnpm deploy` (04 §11).
FROM node:22-alpine AS base
ENV HUSKY=0
RUN corepack enable
WORKDIR /app

# ── Build + collect production dependencies ─────────────────────────────────
FROM base AS build
# Root tsconfig.base.json + tsconfig.json are required: apps/worker/tsconfig.json extends
# "../../tsconfig.base.json", which tsup/esbuild resolves during the build. Copying only apps/ +
# packages/ (below) leaves the root configs out, producing "Cannot find base config file" warnings.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @myos/worker build
# Collect the worker's PRODUCTION dependency closure into /out via `pnpm deploy`. tsup inlines the
# @myos/* workspace packages (noExternal), so the runtime only needs their external deps — pg-boss,
# pino, drizzle-orm, postgres, zod (+ transitives) — which `deploy --prod` installs FLAT and
# node-resolvable in /out/node_modules. NOTE: pnpm 9.15.4 has NO `--legacy` flag (it was invalid and
# never validated because this image had never been built); `--prod` is the correct, supported flag.
RUN pnpm --filter @myos/worker deploy --prod /out

# ── Runtime ─────────────────────────────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /app/apps/worker/dist ./dist
CMD ["node", "dist/index.js"]
