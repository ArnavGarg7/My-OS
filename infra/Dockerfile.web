# syntax=docker/dockerfile:1
# Next.js standalone build for the web app (04 §11).
FROM node:22-alpine AS base
ENV HUSKY=0
RUN corepack enable
WORKDIR /app

# ── Install workspace dependencies (cached on manifests) ────────────────────
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN pnpm install --frozen-lockfile

# ── Build ───────────────────────────────────────────────────────────────────
FROM base AS build
ENV MYOS_BUILD_STANDALONE=1
# Public client-config values (Operations Sprint O1 config fix). Next.js inlines every
# NEXT_PUBLIC_* variable into the client bundle at BUILD time, so these must be present here — the
# container-runtime `.env` is too late. Only PUBLIC values are accepted as build args:
#   - NEXT_PUBLIC_MYOS_VAPID_PUBLIC_KEY : the VAPID *public* key (needed to create push subscriptions).
#   - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY : Clerk's *publishable* key (public by design).
# No private/server-side secret (VAPID private key, CLERK_SECRET_KEY, AI keys, DB creds, vault secrets)
# is EVER passed as a build arg or exposed to the client — those stay runtime-only via `env_file`.
ARG NEXT_PUBLIC_MYOS_VAPID_PUBLIC_KEY=""
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
ENV NEXT_PUBLIC_MYOS_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_MYOS_VAPID_PUBLIC_KEY
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# Copy the ENTIRE installed workspace (root node_modules + every package's node_modules), not just the
# root. pnpm hoists most deps to the root store but the per-package `.bin` symlinks (e.g. apps/web's
# `next` binary) live in `apps/web/node_modules` — copying only `/app/node_modules` leaves them behind,
# so `next build` fails with "next: not found". `.dockerignore` excludes node_modules from the source
# COPY below, so this deps copy is what provides them.
COPY --from=deps /app/ ./
COPY . .
RUN pnpm --filter @myos/web build

# ── Runtime (minimal standalone server) ─────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
